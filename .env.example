# =============================================================================
# Bot Blacklane - Variables d'environnement
# Copier vers .env et remplir les valeurs. Ne jamais commiter .env
# En production: définir IS_PRODUCTION=true et NODE_ENV=production
# =============================================================================

# Supabase (requis)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Production: mettre true pour que acceptOffer appelle vraiment l'API Blacklane
# En dev/staging: false = simulation uniquement (pas d'appel réel)
IS_PRODUCTION=false

# Blacklane API
BLACKLANE_API_URL=https://athena.blacklane.com

# Blacklane partner (pour auth manuelle / tests)
BLACKLANE_EMAIL=
BLACKLANE_PASSWORD=

# Environnement: development | production (logs JSON en production)
NODE_ENV=development

# Optionnel: niveau de log (error, warn, info, debug)
LOG_LEVEL=info

# Chiffrement des mots de passe bots (32 bytes hex). Doit être identique à l'admin si utilisé
ENCRYPTION_KEY=

# Optionnel: proxy HTTP pour les requêtes (ex: IP Royal)
# PROXY_URL=http://user:pass@host:port

# Offres — visibilité des courses lointaines (le endpoint tronque sa réponse à une page)
# Ordre de tri des offres: alternate (défaut, alterne asc/desc pour voir aussi le futur lointain) | asc | desc
# OFFERS_SORT_STRATEGY=alternate
# Optionnel: taille de page demandée (envoyée sous plusieurs noms: per_page, page[size], limit, page_size)
# OFFERS_PAGE_SIZE=100
# Optionnel: nombre max de pages par sondage (1 = défaut, une seule requête; >1 ajoute de la latence)
# OFFERS_MAX_PAGES=1
# Optionnel: log info par appel getOffers (nombre d'offres, fenêtre de pickup, clés de l'enveloppe)
# OFFERS_TRACE=false
